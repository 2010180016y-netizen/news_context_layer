# Shared runtime
NODE_ENV=development
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8787
PORT=8787
LOG_LEVEL=info
DEV_STORE_PATH=infra/dev-data/news-context.store.json
BRIEFING_TIMEZONE_DEFAULT=Asia/Seoul

# Gate 2 placeholders
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
ANALYTICS_SALT=

# Gate 3+ placeholders
# PAYMENT_PROVIDER=
# PAYMENT_SECRET_KEY=

# Support/contact runtime injection
# Local preview reads apps/extension/public/sidepanel/config.js.
# Alpha/unlisted builds can override the same keys through apps/extension/scripts/build-alpha.mjs.
# Leave values blank to keep the product on safe placeholder fallback.
SUPPORT_CHANNEL_STATUS=
SUPPORT_RESPONSE_SLA=
SUPPORT_BETA_URL=
SUPPORT_BILLING_URL=
SUPPORT_QUALITY_URL=
SUPPORT_B2B_URL=

# Chrome Web Store listing metadata placeholders
# These keys affect release metadata only and must not be hard-coded into the repo.
# After injecting real STORE_* values, rebuild alpha and run:
# npm.cmd run release:preflight
STORE_PRIVACY_POLICY_URL=
STORE_TERMS_OF_SERVICE_URL=
STORE_PUBLIC_CONTACT_URL=
